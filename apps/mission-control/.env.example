# Mission Control — environment template.
#
# The Phase 17A/17B mission-control workspace reads JSON artefacts
# from the repository at build time. It does not require any
# secrets, API keys, or network endpoints. This template documents
# the *only* variables Railway or another host may set.

# Port that ``next start`` should listen on. Railway sets this
# automatically; local dev ignores it.
PORT=3000

# Optional: hostname for ``next start``. Defaults to 0.0.0.0 for
# Railway. Set to 127.0.0.1 for a local-only preview.
HOSTNAME=0.0.0.0

# Disable Next.js telemetry. Required by REQ-MCTRL-001 (no network
# egress beyond the local request stream).
NEXT_TELEMETRY_DISABLED=1

# The mission-control workspace MUST NOT define:
#   * OPENAI_API_KEY
#   * ANTHROPIC_API_KEY
#   * COHERE_API_KEY
#   * any GENERATIVE_AI_* key
#   * any URL pointing at a non-loopback host.
# Phase 17B's honesty tests reject those at lint time.

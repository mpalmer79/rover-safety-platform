<?xml version="1.0" encoding="UTF-8"?>
<!--
  SROS2 permissions for the mission-runtime identity (#14 + #18).

  Mission runtime is the only identity permitted to publish on
  /cmd_vel_requested. It does NOT have write access to /cmd_vel_authorized;
  the safety bridge owns that topic.
-->
<permissions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <grant name="/mission_runtime">
    <subject_name>CN=/mission_runtime</subject_name>
    <validity>
      <not_before>2026-01-01T00:00:00</not_before>
      <not_after>2099-01-01T00:00:00</not_after>
    </validity>
    <allow_rule>
      <domains><id>0</id></domains>
      <publish>
        <topics>
          <topic>rt/cmd_vel_requested</topic>
        </topics>
      </publish>
      <subscribe>
        <topics>
          <topic>rt/safety/state</topic>
          <topic>rt/safety/events</topic>
          <topic>rt/safety/motion_authorization</topic>
          <topic>rt/odom</topic>
          <topic>rt/scan</topic>
          <topic>rt/imu</topic>
        </topics>
      </subscribe>
    </allow_rule>
    <default>DENY</default>
  </grant>
</permissions>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  SROS2 permissions for the operator-panel identity (#14 + #18).

  The operator panel is the only identity permitted to publish on the
  /operator/* control topics. Every other identity in the DDS domain
  may subscribe (read) but not publish on these topics.

  Generate the matching keystore with:

    ros2 security create_keystore rover_ws/sros2/keystore
    ros2 security create_enclave rover_ws/sros2/keystore /operator_panel

  Then point the runtime at it:

    export ROS_SECURITY_KEYSTORE=$(pwd)/rover_ws/sros2/keystore
    export ROS_SECURITY_ENABLE=true
    export ROS_SECURITY_STRATEGY=Enforce

  Private keys are NOT checked in; they are generated locally per
  deployment. See rover_ws/sros2/README.md.
-->
<permissions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <grant name="/operator_panel">
    <subject_name>CN=/operator_panel</subject_name>
    <validity>
      <not_before>2026-01-01T00:00:00</not_before>
      <not_after>2099-01-01T00:00:00</not_after>
    </validity>
    <allow_rule>
      <domains><id>0</id></domains>
      <publish>
        <topics>
          <topic>rt/operator/activate</topic>
          <topic>rt/operator/estop</topic>
          <topic>rt/operator/recovery</topic>
          <topic>rt/operator/reset</topic>
          <topic>rt/operator/reset_armed</topic>
        </topics>
      </publish>
      <subscribe>
        <topics>
          <topic>rt/safety/state</topic>
          <topic>rt/safety/events</topic>
          <topic>rt/safety/motion_authorization</topic>
        </topics>
      </subscribe>
    </allow_rule>
    <default>DENY</default>
  </grant>
</permissions>

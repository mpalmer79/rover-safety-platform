<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_observability</name>
  <version>0.1.0</version>
  <description>
    Run lifecycle manager, replay marker publisher, structured event
    JSONL recorder, and rosbag2 launch integration. Aligns with
    docs/REPLAY_SYSTEM.md.
  </description>
  <maintainer email="rover-platform@example.com">Rover Safety Platform</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rosbag2_py</depend>
  <depend>builtin_interfaces</depend>
  <depend>rover_msgs</depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build outputs
build/
dist/

# Frontend (apps/mission-control) - Next.js, vitest, playwright artefacts
# that get rebuilt on every run and were never meant to be committed.
.next/
.turbo/
node_modules/
apps/*/coverage/
apps/*/playwright-report/
apps/*/test-results/

# Editor / IDE state
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Local environment files (never commit secrets)
.env
.env.local
.env.*.local

# Run artefacts (deterministic engine + ROS scenario suites write here)
runs/

# Canonical replay fixtures are committed - they are the deterministic
# baseline that pytest + frontend tests + hydration --check-only verify.
# Phase 20B: a fresh clone must carry these bytes so backend pytest does
# not depend on running the hydration tool first.
!spatial-replay/runs/
!spatial-replay/runs/canonical-fixture/
!spatial-replay/runs/canonical-fixture/**

# SROS2 keystores are generated per deployment. Never commit private
# keys. The enclave permissions XML under rover_ws/sros2/enclaves/ IS
# committed; the keystore directory is not.
rover_ws/sros2/keystore/
